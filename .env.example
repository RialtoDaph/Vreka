NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
# Optional — defaults to a stock ElevenLabs voice if unset.
ELEVENLABS_VOICE_ID=

# Gmail integration (Aslan bisa cek/bales email) — semua di bawah ini wajib
# kalau mau connect Gmail sama sekali. Lihat README bagian "Gmail" buat
# cara setup Google Cloud OAuth client-nya.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Supabase Dashboard -> Project Settings -> API -> service_role secret.
# SANGAT SENSITIF — bypass semua RLS, cuma dipakai di route cron.
SUPABASE_SERVICE_ROLE_KEY=
# String acak bebas, buat proteksi endpoint /api/cron/email-digest biar
# nggak bisa dipanggil orang lain. Vercel otomatis ngirim ini kalau cron
# job-nya jalan.
CRON_SECRET=
