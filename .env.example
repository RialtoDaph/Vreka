NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
ANTHROPIC_API_KEY=
# Powers voice (TTS/STT via OpenAI's audio endpoints) plus the GPT mode in
# Aslan's model switcher. Optional overrides: OPENAI_TTS_MODEL, OPENAI_TTS_VOICE,
# OPENAI_TRANSCRIBE_MODEL.
OPENAI_API_KEY=
# Optional — enables the Gemini and Grok (xAI) options in Aslan's model switcher.
GEMINI_API_KEY=
XAI_API_KEY=

# Gmail integration (Aslan bisa cek/bales email) — semua di bawah ini wajib
# kalau mau connect Gmail sama sekali. Lihat README bagian "Gmail" buat
# cara setup Google Cloud OAuth client-nya.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Supabase Dashboard -> Project Settings -> API -> service_role secret.
# SANGAT SENSITIF — bypass semua RLS, cuma dipakai di route cron.
SUPABASE_SERVICE_ROLE_KEY=
# String acak bebas, buat proteksi endpoint /api/cron/daily-digest biar
# nggak bisa dipanggil orang lain. Vercel otomatis ngirim ini kalau cron
# job-nya jalan.
CRON_SECRET=

# Telegram integration (chat Aslan langsung dari Telegram) — lihat README
# bagian "Telegram" buat cara bikin bot-nya lewat @BotFather.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# String acak bebas kamu (bukan dari Telegram) — dipakai Telegram buat
# ngasih tau webhook request beneran dari mereka, bukan orang lain.
TELEGRAM_WEBHOOK_SECRET=

# Push notification (opsional) — generate sekali pakai
# `npx web-push generate-vapid-keys`, lihat README bagian "PWA & Push
# Notification". NEXT_PUBLIC_VAPID_PUBLIC_KEY harus sama persis dengan
# VAPID_PUBLIC_KEY.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_SUBJECT=

# Sentry error tracking (opsional) — kalau kosong, Sentry sepenuhnya nggak
# aktif (nggak ada request/overhead tambahan). Bikin project gratis di
# sentry.io buat dapetin DSN-nya. NEXT_PUBLIC_SENTRY_DSN wajib sama persis
# dengan SENTRY_DSN (yang satu dibaca browser, yang satu server).
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Opsional, cuma buat upload source map pas build (biar stack trace di
# Sentry kebaca) — bikin di sentry.io -> Settings -> Auth Tokens.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
